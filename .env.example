# =============================================================================
# TechPulse Environment Configuration Example
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the real '.env' file to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. PostgreSQL Database Connection (SQLAlchemy 2.x + Psycopg 3)
# -----------------------------------------------------------------------------
# Option A: Local PostgreSQL (Default port 5432)
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/techpulse_db

# Option B: Cloud PostgreSQL (Neon, Supabase, AWS RDS, etc.)
# Note: Neon URLs require '?sslmode=require'
# DATABASE_URL=postgresql+psycopg://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/techpulse?sslmode=require

# -----------------------------------------------------------------------------
# 2. Optional: LLM Enhancement for AI Career Assistant
# -----------------------------------------------------------------------------
# Leave empty or omit if running fully offline with grounded templates
TECHPULSE_LLM_API_KEY=
# TECHPULSE_LLM_PROVIDER=gemini  # or openai, anthropic

